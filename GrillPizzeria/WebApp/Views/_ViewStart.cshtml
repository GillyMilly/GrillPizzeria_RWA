@{
    var user = ViewContext.HttpContext.User;
    if (user == null || user.Identity?.IsAuthenticated != true)
    {
        Layout = "_Layout";
    }
    else if (user.IsInRole("Admin"))
    {
        Layout = "_LayoutAdmin";
    }
    else if (user.IsInRole("User"))
    {
        Layout = "_LayoutUser";
    }
    else
    {
        Layout = "_Layout";
    }
}
