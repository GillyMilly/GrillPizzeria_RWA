@model WebApp.ViewModels.KorisnikVM

@{
    ViewData["Title"] = "Uredi profil";
}
<link rel="stylesheet" href="~/css/profil.css" asp-append-version="true" />

<div class="profile-container">
    <div class="profile-content">
        <div class="profile-header">
            <h1>Uredi profil</h1>
        </div>

        <form asp-action="KorisnikEdit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Idkorisnik" />

            <div class="profile-form">
                <div class="profile-form-group">
                    <label>Username:</label>
                    <input type="text" value="@Model.Username" readonly />
                </div>
                <div class="profile-form-group">
                    <label asp-for="Email">E-mail:</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="profile-form-group">
                    <label asp-for="Ime">First Name:</label>
                    <input asp-for="Ime" type="text" />
                    <span asp-validation-for="Ime" class="text-danger"></span>
                </div>
                <div class="profile-form-group">
                    <label asp-for="Prezime">Last Name:</label>
                    <input asp-for="Prezime" type="text" />
                    <span asp-validation-for="Prezime" class="text-danger"></span>
                </div>
                <div class="profile-form-group">
                    <label asp-for="Mobitel">Phone:</label>
                    <input asp-for="Mobitel" type="tel" />
                    <span asp-validation-for="Mobitel" class="text-danger"></span>
                </div>
            </div>

            <div class="profile-form-actions">
                <a asp-action="KorisnikDetails" class="profile-btn-cancel">Cancel</a>
                <button type="submit" class="profile-btn-save">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
