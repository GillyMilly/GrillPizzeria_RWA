@model WebApp.ViewModels.SearchVM

@{
    ViewData["Title"] = "Ponuda hrane";
    var isAdmin = User.IsInRole("Admin");
}
<link rel="stylesheet" href="~/css/hrana.css" asp-append-version="true" />

<div class="food-list-container">
    <div class="food-list-header">
        <h1>Ponuda hrane</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (isAdmin)
    {
        <div style="margin-bottom: 1.5rem;">
            <a asp-action="Create" class="btn-add-item">Dodaj Hranu</a>
        </div>
    }

    <!-- Search and Filter Section -->
    <div class="search-filter-section">
        <form asp-action="Search" method="get" id="searchForm">
            <input type="hidden" asp-for="Page" value="1" />
            <input type="hidden" asp-for="PageSize" id="hiddenPageSize" value="@Model.PageSize" />
            <div class="search-filter-row">
                <div class="search-input-group">
                    <input asp-for="SearchTerm" type="text" placeholder="Pretraži hranu..." />
                </div>
                <div class="filter-group">
                    <select asp-for="KategorijaId" asp-items="ViewBag.Categories">
                        <option value="">Sve kategorije</option>
                    </select>
                </div>
                <div class="items-per-page">
                    <select name="PageSize" id="pageSizeSelect">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                    <span>Items</span>
                </div>
                <button type="submit" class="btn-search">Search</button>
            </div>
        </form>
    </div>

    <div id="searchResultsContainer">
        @await Html.PartialAsync("_SearchResults", Model)
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('pageSizeSelect').addEventListener('change', function () {
            document.getElementById('hiddenPageSize').value = this.value;
        });
        $(document).on('click', '#searchResultsContainer .page-link-ajax', function (e) {
            e.preventDefault();
            var page = $(this).data('page');
            if (!page) return;
            var url = '@Url.Action("Search", "Hrana")' + '?page=' + page + '&searchTerm=' + encodeURIComponent($('#SearchTerm').val() || '') + '&kategorijaId=' + encodeURIComponent($('#KategorijaId').val() || '') + '&pageSize=' + ($('#pageSizeSelect').val() || 10) + '&partial=true';
            $.get(url, function (html) {
                $('#searchResultsContainer').html(html);
            }).fail(function () {
                $('#searchResultsContainer').html('<p style="text-align:center;color:#666;">Greška pri učitavanju.</p>');
            });
        });
    </script>
}
