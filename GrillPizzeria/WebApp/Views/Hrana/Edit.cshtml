@model WebApp.ViewModels.HranaVM

@{
    ViewData["Title"] = "Uredi hranu";
}
<link rel="stylesheet" href="~/css/hrana.css" asp-append-version="true" />

<div class="food-form-container">
    <div class="food-form-content">
        <div class="food-form-header">
            <h1>Edit Item</h1>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Idhrana" />
            
            <div class="food-form-grid">
                <div class="food-form-group">
                    <label asp-for="Naslov">Name:</label>
                    <input asp-for="Naslov" type="text" />
                    <span asp-validation-for="Naslov" class="text-danger"></span>
                </div>

                <div class="food-form-group">
                    <label asp-for="KategorijaHraneId">Category:</label>
                    <select asp-for="KategorijaHraneId" asp-items="ViewBag.CategoryDdlItems">
                        <option value="">Odaberi kategoriju</option>
                    </select>
                    <span asp-validation-for="KategorijaHraneId" class="text-danger"></span>
                </div>

                <div class="food-form-group full-width">
                    <label asp-for="Opis">Description:</label>
                    <textarea asp-for="Opis"></textarea>
                    <span asp-validation-for="Opis" class="text-danger"></span>
                </div>

                <div class="food-form-group">
                    <label asp-for="Cijena">Price:</label>
                    <input asp-for="Cijena" type="number" step="0.01" value="@(Model.Cijena.HasValue ? Model.Cijena.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    <span asp-validation-for="Cijena" class="text-danger"></span>
                </div>

                <div class="food-form-group">
                    <label asp-for="SlikaUrl">Image:</label>
                    <input name="imageFile" type="file" accept="image/*" id="imageInput" />
                    @if (!string.IsNullOrEmpty(Model.SlikaUrl))
                    {
                        <div style="margin-top: 0.5rem;">
                            <img src="@Model.SlikaUrl" alt="Current image" style="max-width: 200px; max-height: 200px;" />
                        </div>
                    }
                    <span asp-validation-for="SlikaUrl" class="text-danger"></span>
                    <small style="display: block; margin-top: 0.5rem; color: #666;">Odaberite novu sliku za upload</small>
                </div>

                <div class="food-form-group">
                    <label>Stock:</label>
                    <input type="number" value="1" min="0" />
                </div>

                <div class="food-form-group full-width">
                    <label>Alergeni:</label>
                    <select asp-for="OdabraniAlergeni" multiple asp-items="Model.AlergeniDdl" style="min-height: 100px;">
                    </select>
                    <small style="display: block; margin-top: 0.5rem; color: #666;">Držite Ctrl (Cmd na Mac) za odabir više alergena</small>
                </div>
            </div>

            <div class="food-form-actions">
                <a asp-action="Search" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-save">Save</button>
                <a asp-action="Delete" asp-route-id="@Model.Idhrana" class="btn-delete" onclick="return confirm('Jeste li sigurni da želite obrisati ovu hranu?');">🗑️</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
