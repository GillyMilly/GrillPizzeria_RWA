@model IEnumerable<WebApp.ViewModels.HranaVM>

@{
    ViewData["Title"] = "Hrana";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Hrana</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<p>
    <a asp-action="Search" class="btn btn-primary">Pretraži hranu</a>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-success ms-2">Dodaj hranu</a>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Naslov)</th>
            <th>@Html.DisplayNameFor(model => model.Cijena)</th>
            <th>@Html.DisplayNameFor(model => model.KategorijaNaziv)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Naslov)</td>
                <td>@Html.DisplayFor(modelItem => item.Cijena)</td>
                <td>@Html.DisplayFor(modelItem => item.KategorijaNaziv)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Idhrana" class="btn btn-info btn-sm">Detalji</a>
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Idhrana" class="btn btn-warning btn-sm">Uredi</a>
                        <a asp-action="Delete" asp-route-id="@item.Idhrana" class="btn btn-danger btn-sm">Obriši</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
