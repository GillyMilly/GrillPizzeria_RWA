@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

@if (TempData["SignOutMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 1rem;">
        @TempData["SignOutMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="landing-container-simple">
    <div class="landing-content-centered">
        <h1 class="landing-title-centered">O Grill Pizeriji</h1>
        <p class="landing-description-centered">
            Dobrodošli u GrillPizzeria! Naša web trgovina nudi širok izbor ukusne hrane, 
            od tradicionalnih pizza do raznolikih jela s roštilja. Istražite našu ponudu 
            i pronađite savršeno jelo za svaki trenutak. Sve naše proizvode pripremamo 
            s ljubavlju i pažnjom, koristeći samo najkvalitetnije sastojke.
        </p>
    </div>
</div>
