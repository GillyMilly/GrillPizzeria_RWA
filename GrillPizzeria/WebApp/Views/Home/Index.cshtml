@{
    ViewData["Title"] = "Home Page";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="landing-container">
    <div class="landing-main-content">
        <!-- Left Content Column (Visual Element) - Image 6 -->
        <div class="landing-visual-section">
            <span>🍕</span>
        </div>
        
        <!-- Right Content Column (Text and Call to Action) - Image 6 -->
        <div class="landing-content-section">
            <h1 class="landing-title">Web Shop</h1>
            <p class="landing-description">
                Dobrodošli u GrillPizzeria! Naša web trgovina nudi širok izbor ukusne hrane, 
                od tradicionalnih pizza do raznolikih jela s roštilja. Istražite našu ponudu 
                i pronađite savršeno jelo za svaki trenutak. Sve naše proizvode pripremamo 
                s ljubavlju i pažnjom, koristeći samo najkvalitetnije sastojke.
            </p>
            <a href="@Url.Action("Search", "Hrana")" class="landing-cta-button">See Inside</a>
        </div>
    </div>
</div>
